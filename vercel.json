{
  "rewrites": [
    {
      "source": "/pareja/:token/manifest.webmanifest",
      "destination": "/manifest-pareja.json"
    },
    {
      "source": "/instalar/:token/manifest.webmanifest",
      "destination": "/manifest-instalar.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/avisos",
      "schedule": "0 7 * * *"
    }
  ]
}
